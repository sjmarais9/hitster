# No secrets in this repo, ever. Belt and braces:
.env
.env.*
*.secret

node_modules/
.DS_Store
Thumbs.db

# Scratch output from the import script
data/*.local.json
data/canonicity.json

# Spotify refresh token, so imports do not need a browser every run
.spotify-token.json

# Scheduled import logs
logs/

# Year audit output, regenerable
data/year-audit.json

# Records when the Spotify quota lockout expires
.import-lockout.json

# Candidates already tried and failed, regenerable but slow
data/generation-rejects.json

# Written by import-daily to notice when the pool stops growing.
.import-state.json
